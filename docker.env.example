# ============================================
# Variables de entorno para Docker
# ============================================
# Copia este archivo como .env y rellena los valores
# 
# Uso:
#   cp docker.env.example .env
#   # Edita .env con tus API keys
#   docker-compose up
#
# ============================================

# API Keys
FINNHUB_API_KEY=tu_finnhub_api_key
FMP_API_KEY=tu_fmp_api_key
GEMINI_API_KEY=tu_gemini_api_key

# Auth (genera con: openssl rand -base64 32)
BETTER_AUTH_SECRET=tu_secret_aleatorio_muy_largo

# MongoDB (no cambiar si usas Docker)
# MONGODB_URI se configura automáticamente en docker-compose

NODE_ENV=development
MONGODB_URI=mongodb://root:example@localhost:27017/cavaai?authSource=admin
BETTER_AUTH_SECRET=REDACTED_BY_AUDIT
BETTER_AUTH_URL=REDACTED_BY_AUDIT
FINNHUB_API_KEY=REDACTED_BY_AUDIT
FINNHUB_BASE_URL=REDACTED_BY_AUDIT
GEMINI_API_KEY=AIzaSy_REDACTED_BY_AUDIT
FMP_API_KEY=REDACTED_BY_AUDIT
TWELVE_DATA_API_KEY=REDACTED_BY_AUDIT
ALPHA_VANTAGE_API_KEY=REDACTED_BY_AUDIT
POLYGON_API_KEY=REDACTED_BY_AUDIT
MARKETSTACK_API_KEY=REDACTED_BY_AUDIT

