# ============================================
# Variables de entorno para Docker
# ============================================
# Copia este archivo como .env y rellena los valores.
#
# Uso:
#   cp docker.env.example .env
#   docker compose up --build
#
# AVISO: los defaults de infra abajo son SOLO para desarrollo local.
# No uses estos secretos en producción. Preferible: docker-compose.dev.yml
# con puertos de DB no expuestos al host.

# Market data API keys
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
SEC_USER_AGENT=CavaAI/0.1 contact@example.com
NEWSAPI_KEY=
MARKETAUX_API_KEY=
TRADING_ECONOMICS_API_KEY=

# Single application LLM provider
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# Telegram alerts (leave disabled until a rotated BotFather token is configured)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Thesis approval via Telegram (human-in-the-loop; poller getUpdates).
# Off by default. Con TELEGRAM_APPROVAL_ENABLED=true, generar una tesis envía
# sendMessage con botones inline ✅ Publicar / ✏️ Revisar; el script
# data-engine/scripts/telegram_approval_poll.py procesa los callbacks.
TELEGRAM_APPROVAL_ENABLED=false
# TELEGRAM_APPROVAL_STATE_PATH=./storage/telegram_approval_offset
# TELEGRAM_APPROVAL_POLL_INTERVAL_SECONDS=15

# Auth (32+ chars; example generator: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace_with_a_32_char_minimum_secret
RESEARCH_AUTH_REQUIRED=true
RESEARCH_AUTH_SECRET=replace_with_an_independent_32_char_research_secret

# Infra secrets (required for compose — change in any shared/prod environment)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=cavaai_research
MINIO_ROOT_USER=portfolio
MINIO_ROOT_PASSWORD=portfoliosecret

# Research OS / observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=cavaai-local-langfuse-salt
LANGFUSE_INIT_USER_PASSWORD=

# RAG vectorial local (Qdrant en docker-compose, puerto 6333)
# Activa ingesta de vectores (embeddings locales all-MiniLM-L6-v2, gratis),
# busqueda semantica en /api/search y contexto vectorial en /api/chat.
QDRANT_URL=http://localhost:6333
VECTOR_STORE=qdrant
CAVAAI_ENABLE_VECTOR_INGEST=1
CAVAAI_ENABLE_VECTOR_SEARCH=1
CAVAAI_ENABLE_VECTOR_CHAT=1

# TypeSafe Jev (opcional, micro-decisiones; gratis en Vercel AI Gateway)
#TYPESAFE_API_KEY=
