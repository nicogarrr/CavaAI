# env (todos los locales; solo se versionan los .example)
.env*
!.env.example
!docker.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary files
tmp/

# python
__pycache__/
*.py[cod]
*.egg-info/
*.db
*.db-shm
*.db-wal
*.db-journal
*.db-journal-*
*.sqlite*
data-engine/knowledge_base/
data-engine/funds_cache.json
data-engine/.pytest_cache/
data-engine/storage/.pytest_cache/
data-engine/storage/raw/
# Entornos y cachés de Python dentro del repo. Además de no ser código,
# contienen binarios que el escáner de Tailwind v4 de Next lee como clases:
# generaba utilidades basura del tipo `.pt-[var(--<bytes>)]` y lightningcss
# fallaba con "Unexpected token Ident", dejando `next dev` en 500 para TODAS las
# rutas. En Vercel no se reproduce porque allí no existe .venv.
data-engine/.venv/
data-engine/venv/
data-engine/.ruff_cache/
data-engine/.mypy_cache/
data-engine/htmlcov/

# Builds de verificación de los agentes (no forman parte del producto)
.next-*/

# Snapshots de mercado/reguladores. Son datos, no fuente: 2.008 ficheros y
# ~870 MB, con blobs de un solo ESEF de 59 MB (el 59% del limite de push de
# GitHub). Se regeneran con data-engine/scripts/build_sec_snapshots.py y
# build_esef_snapshots.py, y en produccion viajan como volumen montado.
/data-engine/data/
/data-esef-snapshots/
*.duckdb
*.duckdb.wal
.mypy_cache/
.ruff_cache/
.pytest_cache/

# IDE
.idea/

# Runtime artifacts written by tests/app (never source)
/storage/
