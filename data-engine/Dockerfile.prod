# Imagen de produccion para Oracle Ampere A1 (ARM64, Always Free).
#
# Diferencia con Dockerfile (dev): torch se instala primero desde el indice
# CPU de PyTorch. sentence-transformers/transformers arrastran torch; con el
# indice por defecto eso son ~2-5 GB de wheels CUDA que en una VM CPU-only
# solo ocupan disco (Always Free: 200 GB totales de boot volume). Las wheels
# CPU de torch tienen soporte oficial linux/aarch64 desde torch 2.x.
# Base fijada por digest del MANIFEST LIST (amd64+arm64, para que
# arm64-smoke no falle con "no matching manifest"): `python:3.12-slim` se
# movio a 3.12.15-slim-trixie el 2026-10-01 y sin digest el mismo commit
# producia un SBOM distinto cada dia. Digest de
# docker buildx imagetools inspect python:3.12-slim.
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016 AS base

# Salud: la capa de salud es docker-compose (healthcheck del servicio
# backend con /health/ready). Este Dockerfile no declara HEALTHCHECK propio
# para no duplicar la sonda ni enmascarar el estado real del compose.

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/opt/hf

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# El usuario se crea ANTES del COPY del codigo: COPY --chown necesita que
# exista y asi /app nace con su ownership sin la capa `chown -R` (9,24 MB de
# copia de metadatos que docker history apuntaba a `chown -R cavaai:cavaai
# /app`). Sin shell de login: --no-create-home dejaba /bin/sh como shell de
# depuracion para `su cavaai` o cualquier login; el usuario solo necesita
# ejecutar el CMD (que invoca `sh -c` directamente, sin pasar por passwd).
RUN groupadd --system cavaai && useradd --system --gid cavaai --no-create-home --shell /usr/sbin/nologin cavaai
# /opt/hf es el cache de HuggingFace (HF_HOME). Nace vacio y del usuario de
# runtime: el modelo lo descarga YA el usuario cavaai (abajo), sin chown.
RUN mkdir -p /opt/hf && chown cavaai:cavaai /opt/hf

COPY requirements.txt .

# 1) torch CPU-only (linux/amd64 y linux/aarch64) antes que el resto.
# 2) requirements: sentence-transformers vera torch ya satisfecho.
# Pin sincronizado con requirements.txt (TORCH_CPU_PIN en
# data-engine/scripts/sync_requirements.py).
RUN pip install torch==2.9.1+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

# Modelo de embeddings descargado en build en /opt/hf (legible por el usuario
# no-root). Sin esto el HOME de `cavaai` (--no-create-home) no es escribible,
# SentenceTransformer lanza PermissionError y la busqueda semantica devolvia
# [] en silencio: la tesis corria sin contexto de documentos.
# Revision del modelo fijada por SHA del Hub: sin ella, `all-MiniLM-L6-v2` es
# una referencia movible (el pin no es reproducible) y si HF Hub esta caido no
# se puede construir sin saber QUE revision bajo. El SHA es el de
# huggingface.co/api/models/sentence-transformers/all-MiniLM-L6-v2 (campo sha).
ARG SENTENCE_TRANSFORMERS_REV=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# La descarga corre como el usuario de RUNTIME: el cache nace de su propiedad
# (sigue habiendo permiso de escritura en runtime, que es lo que evita el
# PermissionError de busqueda semantica) y no hace falta ninguna capa chown.
USER cavaai
RUN SENTENCE_TRANSFORMERS_REV="${SENTENCE_TRANSFORMERS_REV}" python -c "import os; from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2', revision=os.environ['SENTENCE_TRANSFORMERS_REV'])" \
    && chmod -R a+rX /opt/hf
USER root
# Carga realmente offline en runtime: el modelo ya esta en /opt/hf; sin esto
# SentenceTransformer consulta HF Hub y puede necesitar escribir en la cache.
ENV HF_HUB_OFFLINE=1

# quantstats va vendorizado dentro de data-engine/. Con --chown el codigo nace
# del usuario de runtime: sin `chown -R` posterior.
COPY --chown=cavaai:cavaai . .

EXPOSE 8000

# El compose de produccion monta `duckdb_data` y `./data-esef-snapshots` en
# /data con modo lectura-escritura, asi que root en este contenedor significa
# root sobre esos volumenes para cualquier RCE de la app. El usuario no-root
# ya existe arriba; los volumenes ya los monta docker-compose, que puede
# fijar el ownership con `user:`.
# /data es el punto de montaje de duckdb_data en produccion. Un volumen named
# nuevo se inicializa copiando contenido Y propietario de esta ruta desde la
# imagen; sin el chown nace root-owned y el backend (USER cavaai) no puede
# escribir analytics.duckdb.
RUN mkdir -p /data && chown cavaai:cavaai /data
USER cavaai

# Las migraciones son idempotentes (alembic upgrade head es seguro al
# arrancar; con una sola replica no hay carreras).
#
# `sh -c` no hace exec del ultimo comando: sh queda como PID 1 y uvicorn como
# hijo, de modo que `docker stop` envia SIGTERM a sh, que no lo reenvia, y a los
# 10 s llega SIGKILL: sin teardown del lifespan, sin scheduler.shutdown() y con
# las peticiones en vuelo cortadas. El `exec` delega la senal.

# --proxy-headers + --forwarded-allow-ips: todo el trafico externo entra por
# Caddy (misma red docker), asi que la IP del socket siempre es la de Caddy.
# Sin confiar en X-Forwarded-For el rate limiter (app/core/rate_limit.py)
# agrupa a TODOS los clientes del mismo tenant en un solo bucket
# (tenant:user@<ip-de-caddy>) y unas pocas pestanas abiertas agotan los
# 300 req/min: tormenta de 429 con el backend sano (F53/F54/F55/F203).
# Se confia solo en proxies del rango de redes docker (172.16.0.0/12);
# configurable con FORWARDED_ALLOW_IPS.
CMD ["sh", "-c", "python -m alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips \"${FORWARDED_ALLOW_IPS:-172.16.0.0/12}\""]
