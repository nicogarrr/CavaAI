# Imagen de produccion para Oracle Ampere A1 (ARM64, Always Free).
#
# Diferencia con Dockerfile (dev): torch se instala primero desde el indice
# CPU de PyTorch. sentence-transformers/transformers arrastran torch; con el
# indice por defecto eso son ~2-5 GB de wheels CUDA que en una VM CPU-only
# solo ocupan disco (Always Free: 200 GB totales de boot volume). Las wheels
# CPU de torch tienen soporte oficial linux/aarch64 desde torch 2.x.
FROM python:3.12-slim AS base

# Salud: la capa de salud es docker-compose (healthcheck del servicio
# backend con /health/ready). Este Dockerfile no declara HEALTHCHECK propio
# para no duplicar la sonda ni enmascarar el estado real del compose.

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# 1) torch CPU-only (linux/amd64 y linux/aarch64) antes que el resto.
# 2) requirements: sentence-transformers vera torch ya satisfecho.
# Pin sincronizado con requirements.txt (TORCH_CPU_PIN en
# data-engine/scripts/sync_requirements.py).
RUN pip install torch==2.9.1+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

# quantstats va vendorizado dentro de data-engine/
COPY . .

EXPOSE 8000

# El compose de produccion monta `duckdb_data` y `./data-esef-snapshots` en
# /data con modo lectura-escritura, asi que root en este contenedor significa
# root sobre esos volumenes para cualquier RCE de la app. Se crea un usuario
# sin shell y se le entrega la propiedad de /app; los volumenes ya los
# monta docker-compose, que puede fijar el ownership con `user:`.
RUN groupadd --system cavaai && useradd --system --gid cavaai --no-create-home cavaai \
    && chown -R cavaai:cavaai /app
# /data es el punto de montaje de duckdb_data en produccion. Un volumen named
# nuevo se inicializa copiando contenido Y propietario de esta ruta desde la
# imagen; sin el chown nace root-owned y el backend (USER cavaai) no puede
# escribir analytics.duckdb.
RUN mkdir -p /data && chown cavaai:cavaai /data
USER cavaai

# Las migraciones son idempotentes (alembic upgrade head es seguro al
# arrancar; con una sola replica no hay carreras).
#
# `sh -c` no hace exec del ultimo comando: sh queda como PID 1 y uvicorn como
# hijo, de modo que `docker stop` envia SIGTERM a sh, que no lo reenvia, y a los
# 10 s llega SIGKILL: sin teardown del lifespan, sin scheduler.shutdown() y con
# las peticiones en vuelo cortadas. El `exec` delega la senal.

# --proxy-headers + --forwarded-allow-ips: todo el trafico externo entra por
# Caddy (misma red docker), asi que la IP del socket siempre es la de Caddy.
# Sin confiar en X-Forwarded-For el rate limiter (app/core/rate_limit.py)
# agrupa a TODOS los clientes del mismo tenant en un solo bucket
# (tenant:user@<ip-de-caddy>) y unas pocas pestanas abiertas agotan los
# 300 req/min: tormenta de 429 con el backend sano (F53/F54/F55/F203).
# Se confia solo en proxies del rango de redes docker (172.16.0.0/12);
# configurable con FORWARDED_ALLOW_IPS.
CMD ["sh", "-c", "python -m alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips \"${FORWARDED_ALLOW_IPS:-172.16.0.0/12}\""]
