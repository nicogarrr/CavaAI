# ============================================
# Dockerfile.dev - Frontend Next.js (Desarrollo)
# ============================================
# Con hot-reload para desarrollo

FROM node:22-alpine

WORKDIR /app

# Instalar dependencias del sistema
RUN apk add --no-cache libc6-compat

# Usuario sin privilegios (Trivy DS-0002). /app/.next se crea aqui para que el
# volumen anonimo de docker-compose herede el propietario node y no root.
RUN mkdir -p /app/.next && chown -R node:node /app
USER node

# Copiar archivos de dependencias
COPY --chown=node:node package.json package-lock.json* ./

# Instalar dependencias
RUN npm ci

# El código se monta como volumen en docker-compose
# No lo copiamos aquí para permitir hot-reload

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Comando de desarrollo con hot-reload
CMD ["npm", "run", "dev"]

