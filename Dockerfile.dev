# ============================================
# Dockerfile.dev - Frontend Next.js (Desarrollo)
# ============================================
# Con hot-reload para desarrollo

# Base fijada por digest del MANIFEST LIST (amd64+arm64), igual que Dockerfile:
# sin él, `node:22-alpine` es una etiqueta móvil y el mismo commit produce un
# SBOM distinto cada día.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

WORKDIR /app

# Instalar dependencias del sistema
RUN apk add --no-cache libc6-compat

# Copiar archivos de dependencias
COPY package.json package-lock.json* ./

# Instalar dependencias
RUN npm ci

# El código se monta como volumen en docker-compose
# No lo copiamos aquí para permitir hot-reload

# Directorios que el compose monta como volumenes anonimos (/app/node_modules
# y /app/.next): Docker inicializa un volumen nuevo copiando el contenido Y el
# ownership de esta ruta, asi que se preparan aqui. 0777 porque el uid real del
# proceso no es el de la imagen: lo fija docker-compose con `user:` y
# LOCAL_UID/LOCAL_GID del host (el bind mount .:/app pertenece a ese uid; con
# USER de la imagen a secas, `npm run dev` recibe EACCES al escribir).
RUN mkdir -p /app/.next /app/node_modules/.cache \
    && chmod 0777 /app/.next /app/node_modules/.cache

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Default para `docker run` a pelo (no root). El compose lo pisa con `user:`
# para que las escrituras sobre el bind mount coincidan con el uid del host.
USER node

# Comando de desarrollo con hot-reload
CMD ["npm", "run", "dev"]

