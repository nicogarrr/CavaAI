    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-select-country-list": "^2.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "mongodb-memory-server": "^11.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "dotenv": "^17.2.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "postcss": "8.5.26"
  },
  "description": "CavaAI — Research OS de inversión personal (Next.js + FastAPI)"
}
